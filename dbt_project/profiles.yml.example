bi_commercial:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5432
      user: bi_user
      password: '{{ env_var("DB_PASSWORD") }}'
      dbname: bi_commercial
      schema: public
      threads: 4
    prod:
      type: postgres
      host: '{{ env_var("DB_HOST") }}'
      port: 5432
      user: '{{ env_var("DB_USER") }}'
      password: '{{ env_var("DB_PASSWORD") }}'
      dbname: bi_commercial
      schema: public
      threads: 8
